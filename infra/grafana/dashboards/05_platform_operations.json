    {
      "id": 10,
      "type": "table",
      "title": "مراقبة التأخير الزمني لجداول طبقة Gold (دقائق التأخر)",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "التأخير_بالدقائق"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 120
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT table AS \"اسم_الجدول\", max(modification_time) AS \"آخر_تحديث\", round(dateDiff('minute', max(modification_time), now()), 0) AS \"التأخير_بالدقائق\", count() AS \"عدد_الأجزاء_النشطة\" FROM system.parts WHERE active AND database = 'agri_gold' GROUP BY table ORDER BY max(modification_time) ASC",
          "format": "table"
        }
      ]
    },
