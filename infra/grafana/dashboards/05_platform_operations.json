      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT table AS \"الجدول\", formatReadableQuantity(sum(rows)) AS \"إجمالي_السجلات\", formatReadableSize(sum(bytes_on_disk)) AS \"الحجم_على_القرص\", any(engine) AS \"نوع_المحرك\" FROM system.parts WHERE active AND database = 'agri_gold' GROUP BY table ORDER BY sum(bytes_on_disk) DESC",
          "format": "table"
        }
      ]
    },
