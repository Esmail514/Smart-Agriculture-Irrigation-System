    {
      "id": 10,
      "type": "table",
      "title": "حداثة البيانات الفعلية (Business data freshness)",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "الحالة"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Fresh": {
                        "text": "Fresh",
                        "color": "green"
                      },
                      "Stale": {
                        "text": "Stale",
                        "color": "red"
                      },
                      "No data": {
                        "text": "No data",
                        "color": "gray"
                      },
                      "Future timestamp": {
                        "text": "Future timestamp",
                        "color": "orange"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT dataset AS \"البيانات\", row_count AS \"عدد_الصفوف\", if(row_count = 0, NULL, last_update) AS \"آخر_حدث\", if(row_count = 0, NULL, dateDiff('minute', last_update, now())) AS \"التأخير_بالدقائق\", max_age_minutes AS \"الحد_بالدقائق\", multiIf(row_count=0, 'No data', last_update>now(), 'Future timestamp', last_update<now()-toIntervalMinute(max_age_minutes), 'Stale', 'Fresh') AS \"الحالة\" FROM (SELECT 'zone_summary_latest' AS dataset, count() AS row_count, max(last_update) AS last_update, 10 AS max_age_minutes FROM agri_gold.zone_summary_latest UNION ALL SELECT 'farm_summary_latest', count(), max(last_update), 10 FROM agri_gold.farm_summary_latest UNION ALL SELECT 'farm_weather_daily', count(), max(last_update), 120 FROM agri_gold.farm_weather_daily UNION ALL SELECT 'ml_predictions', count(), toDateTime(max(prediction_time)), 10 FROM agri_gold.ml_predictions FINAL) ORDER BY dataset",
          "format": "table"
        }
      ],
      "description": "Age of the newest business row per dataset; does not prove every farm/zone is fresh. Sensor thresholds 10 minutes, weather120minutes. ML timestamp is output creation, not feature evidence age; the app separately validates evidence."
    },
