                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "الحجم_على_القرص"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "إجمالي_السجلات"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT table AS \"الجدول\", sum(rows) AS \"إجمالي_السجلات\", sum(bytes_on_disk) AS \"الحجم_على_القرص\", any(engine) AS \"نوع_المحرك\" FROM system.parts WHERE active AND database = 'agri_gold' GROUP BY table ORDER BY sum(bytes_on_disk) DESC",
          "format": "table"
        }
      ],
      "description": "Physical active part rows, including unmerged retry duplicates in ReplacingMergeTree tables; not a logical deduplicated row count."
    },
