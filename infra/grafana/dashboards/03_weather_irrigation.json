          "rawSql": "SELECT farm_name AS \"المزرعة\", zone_name AS \"المنطقة\", crop_name AS \"المحصول\", round(soil_moisture, 1) AS \"رطوبة_التربة_%\", round(expected_rain, 1) AS \"المطر_المتوقع_mm\", round(recommended_water_mm, 1) AS \"الماء_الموصى_mm\", irrigation_decision AS \"قرار_الري\", weather_condition AS \"الطقس\", processing_time AS \"وقت_المعالجة\" FROM agri_gold.weather_irrigation_alerts WHERE farm_name LIKE '$farm_name' ORDER BY processing_time DESC LIMIT 50",
