      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT farm_name AS \"المزرعة\", zone_name AS \"المنطقة\", crop_name AS \"المحصول\", sensor_count AS \"المستشعرات\", round(avg_soil_moisture, 1) AS \"رطوبة_التربة_%\", round(avg_soil_temperature, 1) AS \"حرارة_التربة_C\", round(avg_air_temperature, 1) AS \"حرارة_الهواء_C\", round(avg_air_humidity, 1) AS \"رطوبة_الهواء_%\", round(recommended_water_mm, 1) AS \"ماء_موصى_mm\", water_status AS \"حالة_الماء\", last_update AS \"آخر_تحديث\" FROM agri_gold.zone_summary_latest WHERE farm_name LIKE '$farm_name' AND zone_name LIKE '$zone_name' ORDER BY farm_name, zone_name",
