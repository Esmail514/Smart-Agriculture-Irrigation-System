# ============================================================
# Smart Agriculture Irrigation System — Environment Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control — it is git-ignored.
# ============================================================

# --- Project ---
COMPOSE_PROJECT_NAME=smart-agri

# ============================================================
# PostgreSQL (Metadata + Crop/Field Data)
# ============================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
INTERNAL_POSTGRES_PORT=5432
POSTGRES_USER=your_pg_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=smart_agriculture
POSTGRES_AIRFLOW_DB=airflow

# ============================================================
# MinIO (Data Lake - S3-Compatible Object Storage)
# ============================================================
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=change_me
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY default to MINIO_ROOT_USER/PASSWORD if unset.
# Only define them if you want different keys from the root user.
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=change_me
MINIO_ENDPOINT=http://minio:9000
MINIO_ENDPOINT_EXTERNAL=http://localhost:9000
MINIO_REGION=us-east-1

# MinIO Buckets
MINIO_BUCKET_agri-lakehouse=agri-lakehouse
LAKEHOUSE_BUCKET=agri-lakehouse

# ============================================================
# Kafka (KRaft Mode - No ZooKeeper)
# ============================================================
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_NODE_ID=1
KAFKA_ADVERTISED_HOST=kafka
KAFKA_BROKER_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_EXTERNAL_PORT=9094
KAFKA_JMX_USERNAME=your_jmx_user
KAFKA_JMX_PASSWORD=change_me

# Kafka client connection
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Kafka Topics (created at startup)
KAFKA_TOPIC_SENSORS=agri.sensors.raw
KAFKA_TOPIC_WEATHER=agri.weather.raw
KAFKA_TOPIC_ALERTS=agri.alerts
KAFKA_TOPIC_COMMANDS=agri.irrigation.commands

# ============================================================
# Spark
# ============================================================
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8090
SPARK_WORKER_WEBUI_PORT=8091
SPARK_HISTORY_PORT=18080
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g

# Spark streaming trigger interval (e.g. "1 minute", "30 seconds")
STREAM_TRIGGER_INTERVAL=1 minute

# ============================================================
# ClickHouse (Analytics / Serving Layer)
# ============================================================
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=your_ch_user
CLICKHOUSE_PASSWORD=change_me
CLICKHOUSE_DB=agri_gold
CLICKHOUSE_PROMETHEUS_PORT=8001

# ============================================================
# Airflow
# ============================================================
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.1
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_ADMIN_USER=your_airflow_user
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=admin@smartagri.local
AIRFLOW_ADMIN_FIRSTNAME=First
AIRFLOW_ADMIN_LASTNAME=Last
AIRFLOW_FERNET_KEY=generate_a_fernet_key_with_python
AIRFLOW_SECRET_KEY=generate_a_random_secret_key
AIRFLOW_EXECUTOR=CeleryExecutor

# ============================================================
# Redis (Celery Broker for Airflow)
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# ============================================================
# Prometheus
# ============================================================
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d

# ============================================================
# Grafana
# ============================================================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=your_grafana_user
GRAFANA_ADMIN_PASSWORD=change_me

# ============================================================
# JMX Exporter (Kafka Metrics)
# ============================================================
JMX_EXPORTER_PORT=9101

# ============================================================
# Jupyter Notebook
# ============================================================
JUPYTER_PORT=8888
JUPYTER_TOKEN=change_me

# ============================================================
# Streaming / Simulator
# ============================================================
# Sensor simulator send interval (seconds between batches)
SEND_INTERVAL=5
# Anomaly rate (0.0 - 1.0) injected by the simulator for testing the rejected path
ANOMALY_RATE=0.03

# ============================================================
# ML
# ============================================================
# Skip irrigation if expected rain in the next 24h exceeds this threshold (mm)
RAIN_SKIP_THRESHOLD_MM=2.0

# ============================================================
# Weather API — OpenWeatherMap
# ============================================================
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ============================================================
# Timezone
# ============================================================
TZ=UTC
